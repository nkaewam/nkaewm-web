---
import Layout from "@/layouts/main.astro"
import Image from "astro/components/Image.astro"
import { getCollection } from "astro:content"
import BlogSummary from "@/components/blocks/blog/blog-summary"

const blogPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)
---

<Layout>
  <main class="flex min-h-svh flex-col items-center px-6 py-16 sm:py-24">
    <div class="flex w-full max-w-2xl flex-col items-center gap-20 text-sm leading-relaxed">
      <header class="flex flex-col items-center text-center">
        <Image src="/nkaewam.png" alt="Nonthapat Kaewamporn" width={75} height={75} />

        <h1 class="text-4xl mt-6">
          Nonthapat Kaewamporn
        </h1>

        <p class="text-lg">
          Customer Engineering @ Google
        </p>

        <nav class="mt-1 flex font-mono text-sm gap-4 font-light">
          <a href="mailto:nonthapatkeawamporn@gmail.com" target="_blank" rel="noopener noreferrer">email</a>
          <a href="https://github.com/nkaewam" target="_blank" rel="noopener noreferrer">github</a>
          <a href="https://linkedin.com/in/nkaewam" target="_blank" rel="noopener noreferrer">linkedin</a>
        </nav>
      </header>

      <section class="w-full">
        <h2 class="text-xl mb-4">Blogs</h2>
        {
          blogPosts.length > 0 && (
            <ul class="flex flex-col gap-3">
              {blogPosts.map((post) => (
                <li>
                  <BlogSummary
                    title={post.data.title}
                    subtitle={post.data.subtitle}
                    alias={post.id}
                    date={post.data.date}
                  />
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </main>
</Layout>
